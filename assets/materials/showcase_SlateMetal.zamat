[material]
shader = "fusion/standard"

[render_state]
alpha_mode = "solid"
alpha_cutoff = 0.5
double_sided = false
cull_mode = "back"
depth_test = true
depth_write = true
blend_mode = "disabled"

[texture.u_albedo]
path = "textures/showcase_white_albedo.png"
uv_set = 0
uv_offset = [0, 0]
uv_scale = [1, 1]
uv_rotation = 0
min_filter = "linear"
mag_filter = "linear"
mip_filter = "linear"
wrap_s = "repeat"
wrap_t = "repeat"
max_anisotropy = 1

[params]
u_base_color = [0.16, 0.23, 0.28, 1]
u_metallic = 0.72
u_roughness = 0.28
u_emissive = [0.01, 0.015, 0.02]
