# MASK material: exercises alpha testing and double-sided rendering.
[material]
shader = "fusion/standard"

[render_state]
alpha_mode = "alpha_test"
alpha_cutoff = 0.42
double_sided = true
cull_mode = "none"
depth_test = true
depth_write = true
blend_mode = "disabled"

[texture.u_albedo]
path = "textures/showcase_foliage_albedo.png"
uv_set = 0
uv_offset = [0, 0]
uv_scale = [1, 1]
uv_rotation = 0
min_filter = "linear"
mag_filter = "linear"
mip_filter = "linear"
wrap_s = "clamp_to_edge"
wrap_t = "clamp_to_edge"
max_anisotropy = 1

[params]
u_base_color = [0.82, 0.9, 0.76, 1]
u_metallic = 0.0
u_roughness = 1.0
u_emissive = [0.005, 0.012, 0.003]
