# BLEND material: exercises transparency, disabled depth writes, and emissive tint.
[material]
shader = "shaders/basic"

[render_state]
alpha_mode = "alpha_blend"
alpha_cutoff = 0.5
double_sided = true
cull_mode = "none"
depth_test = true
depth_write = false
blend_mode = "alpha"

[texture.albedo]
path = "textures/showcase_trail_map_albedo.png"
resource = "u_albedo"
set = 0
binding = 0
uv_set = 0
uv_offset = [0, 0]
uv_scale = [1, 1]
uv_rotation = 0
min_filter = "linear"
mag_filter = "linear"
mip_filter = "linear"
wrap_s = "clamp_to_edge"
wrap_t = "clamp_to_edge"
max_anisotropy = 1

[param.u_base_color]
value = [0.75, 1, 1, 0.64]
set = 1
binding = 0
[param.u_metallic]
value = 0.0
set = 1
binding = 1
[param.u_roughness]
value = 0.2
set = 1
binding = 2
[param.u_emissive]
value = [0.03, 0.16, 0.20]
set = 1
binding = 3
[param.u_uv_scale]
value = [1, 1]
set = 1
binding = 4
