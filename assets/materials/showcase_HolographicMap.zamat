# BLEND material: exercises transparency, disabled depth writes, and emissive tint.
[material]
shader = "zephyr/standard"

[render_state]
alpha_mode = "alpha_blend"
alpha_cutoff = 0.5
double_sided = true
cull_mode = "none"
depth_test = true
depth_write = false
blend_mode = "alpha"

[texture.u_albedo]
path = "textures/showcase_trail_map_albedo.png"
uv_set = 0
uv_offset = [0, 0]
uv_scale = [1, 1]
uv_rotation = 0
min_filter = "linear"
mag_filter = "linear"
mip_filter = "linear"
wrap_s = "clamp_to_edge"
wrap_t = "clamp_to_edge"
max_anisotropy = 1

[params]
u_base_color = [0.75, 1, 1, 0.64]
u_metallic = 0.0
u_roughness = 0.2
u_emissive = [0.03, 0.16, 0.20]
u_uv_scale = [1, 1]
