# Hand-authored showcase override: textured opaque wood/brick surface.
[material]
shader = "zephyr/standard"

[render_state]
alpha_mode = "solid"
alpha_cutoff = 0.5
double_sided = false
cull_mode = "back"
depth_test = true
depth_write = true
blend_mode = "disabled"

[texture.u_albedo]
path = "textures/brick_albedo.jpg"
uv_set = 0
uv_offset = [0, 0]
uv_scale = [2.5, 1.0]
uv_rotation = 0
min_filter = "linear"
mag_filter = "linear"
mip_filter = "linear"
wrap_s = "repeat"
wrap_t = "repeat"
max_anisotropy = 1

[params]
u_base_color = [0.72, 0.48, 0.28, 1]
u_metallic = 0.0
u_roughness = 0.88
u_emissive = [0, 0, 0]
